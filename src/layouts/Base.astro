---
/**
 * Base.astro — master page layout
 * Every page on the site uses this layout.
 * Required legal/trust links in footer per docs/SPEC.md section 8.
 */
import { SITE_CONFIG } from '../config';
import '../styles/global.css';

interface Props {
  /** Used in <title> and og:title */
  metaTitle: string;
  /** Used in <meta name="description"> and og:description */
  metaDescription: string;
  /** Explicit canonical URL. Defaults to current path + site domain. */
  canonical?: string;
  /** Set true for draft pages (adds noindex, nofollow) */
  noindex?: boolean;
}

const {
  metaTitle,
  metaDescription,
  canonical: canonicalProp,
  noindex = false,
} = Astro.props;

const canonicalUrl =
  canonicalProp ?? new URL(Astro.url.pathname, SITE_CONFIG.domain).href;

const fullTitle = metaTitle.includes(SITE_CONFIG.siteName)
  ? metaTitle
  : `${metaTitle} | ${SITE_CONFIG.siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name"   content={SITE_CONFIG.siteName} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <!-- Skip to main content (keyboard / screen-reader accessibility) -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Site header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-logo" aria-label={`${SITE_CONFIG.siteName} home`}>
          <svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <rect width="100" height="100" rx="20" fill="currentColor" />
            <text x="50" y="68" font-size="52" font-family="system-ui,sans-serif"
              font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>
          </svg>
          <span>{SITE_CONFIG.siteName}</span>
        </a>

        <nav aria-label="Site navigation">
          <ul class="nav-list">
            <li><a href="/categories/">Calculators</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <!-- Site footer -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-disclaimer">
          Results are estimates. Confirm quantities with your supplier before you buy.
        </p>
        <nav aria-label="Footer navigation">
          <ul class="footer-links">
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms and Disclaimer</a></li>
          </ul>
        </nav>
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} {SITE_CONFIG.siteName}.
          Calculators provide estimates only.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Site header ─────────────────────────────────────────────────────────── */
  .site-header {
    background: var(--action);
    color: var(--page);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 48px;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--page);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .site-logo:hover { text-decoration: underline; }
  .site-logo:focus-visible { outline-color: var(--page); }

  /* ── Navigation ──────────────────────────────────────────────────────────── */
  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
  }

  .nav-list a {
    color: rgba(255 255 255 / 0.9);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .nav-list a:hover { color: var(--page); text-decoration: underline; }
  .nav-list a:focus-visible { outline-color: var(--page); }

  /* ── Main content ────────────────────────────────────────────────────────── */
  .site-main {
    padding: var(--space-8) 0 var(--space-12);
  }

  /* ── Footer ──────────────────────────────────────────────────────────────── */
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--page);
    padding: var(--space-8) 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-disclaimer {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-2) var(--space-6);
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer-links a:hover { color: var(--ink); }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }
</style>
