---
/**
 * Base.astro — master page layout
 * Every page on the site uses this layout.
 * Required legal/trust links in footer per docs/SPEC.md section 8.
 */
import { SITE_CONFIG } from '../config';
import '../styles/global.css';

interface Props {
  /** Used in <title> and og:title */
  metaTitle: string;
  /** Used in <meta name="description"> and og:description */
  metaDescription: string;
  /** Explicit canonical URL. Defaults to current path + site domain. */
  canonical?: string;
  /** Set true for draft pages (adds noindex, nofollow) */
  noindex?: boolean;
}

const {
  metaTitle,
  metaDescription,
  canonical: canonicalProp,
  noindex = false,
} = Astro.props;

const canonicalUrl =
  canonicalProp ?? new URL(Astro.url.pathname, SITE_CONFIG.domain).href;

const fullTitle = metaTitle.includes(SITE_CONFIG.siteName)
  ? metaTitle
  : `${metaTitle} | ${SITE_CONFIG.siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Avatar -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name"   content={SITE_CONFIG.siteName} />
    <meta property="og:image"       content={new URL('/calckit-icon-180.png', SITE_CONFIG.domain).href} />
    <meta property="og:image:width"  content="180" />
    <meta property="og:image:height" content="180" />
    <meta property="og:image:alt"    content={`${SITE_CONFIG.siteName} Logo`} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image"       content={new URL('/calckit-icon-180.png', SITE_CONFIG.domain).href} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/calckit-favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/calckit-icon-180.png" />
  </head>

  <body>
    <!-- Skip to main content (keyboard / screen-reader accessibility) -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Site header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-logo">
          <svg width="28" height="28" viewBox="0 0 512 512" aria-hidden="true" focusable="false" class="site-logo-icon">
            <rect width="512" height="512" rx="112" fill="#F5B700"/>
            <path d="M318.6 337.7 A110 110 0 1 1 318.6 174.3" fill="none" stroke="#14213D" stroke-width="72" stroke-linecap="round"/>
            <rect x="361" y="230" width="52" height="52" rx="9" fill="#14213D"/>
          </svg>
          <span>{SITE_CONFIG.siteName}</span>
        </a>

        <nav aria-label="Site navigation">
          <ul class="nav-list">
            <li><a href="/categories/">Calculators</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <!-- Site footer -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <svg width="22" height="22" viewBox="0 0 512 512" aria-hidden="true" focusable="false" class="site-logo-icon">
                <rect width="512" height="512" rx="112" fill="#F5B700"/>
                <path d="M318.6 337.7 A110 110 0 1 1 318.6 174.3" fill="none" stroke="#14213D" stroke-width="72" stroke-linecap="round"/>
                <rect x="361" y="230" width="52" height="52" rx="9" fill="#14213D"/>
              </svg>
              <span>{SITE_CONFIG.siteName}</span>
            </a>
            <p class="footer-tagline">Free material calculators for US homeowners and DIYers.</p>
          </div>
          <nav aria-label="Footer navigation">
            <ul class="footer-links">
              <li><a href="/categories/">Calculators</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-bottom">
          <p class="footer-disclaimer">
            Results are estimates. Confirm quantities with your supplier before you buy.
          </p>
          <p class="footer-copy">
            &copy; {new Date().getFullYear()} {SITE_CONFIG.siteName}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Site header ─────────────────────────────────────────────────────────── */
  .site-header {
    background: var(--action);
    color: var(--page);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 48px;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--page);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .site-logo-icon {
    flex-shrink: 0;
    display: block;
    border-radius: 6px;
  }

  .site-logo:hover { text-decoration: underline; }
  .site-logo:focus-visible { outline-color: var(--page); }

  /* ── Navigation ──────────────────────────────────────────────────────────── */
  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
  }

  .nav-list a {
    color: rgba(255 255 255 / 0.9);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .nav-list a:hover { color: var(--page); text-decoration: underline; }
  .nav-list a:focus-visible { outline-color: var(--page); }

  /* ── Main content ────────────────────────────────────────────────────────── */
  .site-main {
    padding: var(--space-8) 0 var(--space-12);
  }

  /* ── Footer ──────────────────────────────────────────────────────────────── */
  .site-footer {
    border-top: 1px solid var(--rule);
    background: #f9fafb;
    padding: var(--space-8) 0 var(--space-6);
    margin-top: var(--space-12);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 480px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
  }
  .footer-logo:hover { text-decoration: underline; }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
    max-width: 32ch;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-2) var(--space-5);
  }

  .footer-links a {
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover { color: var(--ink); text-decoration: underline; }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 480px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
  }
</style>
