---
/**
 * CalculatorDiagram.astro
 * Visual, accurate technical diagrams for CalcKit calculators.
 * Renders inline SVG dimension diagrams that illustrate exact measurements (L x W x Depth/Height)
 * and practical buying tips.
 */

interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---

<div class="calc-diagram-card" aria-label={`Measurement diagram for ${title}`}>
  <div class="diagram-header">
    <div class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M2 12h20M12 2v20M7 7l10 10M17 7L7 17"/>
      </svg>
      <span>Visual Measurement Guide</span>
    </div>
    <span class="diagram-hint">How to measure your space accurately</span>
  </div>

  <div class="diagram-viewport">
    {slug === 'mulch-calculator' && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="Garden bed mulch depth diagram">
        <!-- Background bed perspective -->
        <defs>
          <linearGradient id="mulchGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#5c3818"/>
            <stop offset="100%" stop-color="#3d220a"/>
          </linearGradient>
          <linearGradient id="soilGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#8c6239"/>
            <stop offset="100%" stop-color="#54381e"/>
          </linearGradient>
        </defs>

        <!-- Subsoil block -->
        <polygon points="60,95 380,95 480,150 160,150" fill="url(#soilGrad)" opacity="0.6"/>
        <polygon points="160,150 480,150 480,185 160,185" fill="#422c18" opacity="0.7"/>

        <!-- Mulch top layer -->
        <polygon points="60,70 380,70 480,125 160,125" fill="url(#mulchGrad)"/>
        <!-- Mulch front depth face -->
        <polygon points="160,125 480,125 480,150 160,150" fill="#321b07"/>
        <polygon points="60,70 160,125 160,150 60,95" fill="#44260d"/>

        <!-- Decorative plants on mulch -->
        <path d="M240,75 Q245,50 255,42 Q260,55 250,75" fill="#15803d"/>
        <path d="M247,75 Q235,55 230,48 Q240,60 248,75" fill="#16a34a"/>
        <path d="M340,90 Q345,68 355,60 Q360,72 350,90" fill="#15803d"/>
        <path d="M347,90 Q335,72 330,65 Q340,75 348,90" fill="#16a34a"/>

        <!-- Length arrow (top edge) -->
        <line x1="60" y1="58" x2="380" y2="58" stroke="#1d53c4" stroke-width="2" marker-start="url(#dot)" marker-end="url(#dot)"/>
        <path d="M60,54 L52,58 L60,62 M380,54 L388,58 L380,62" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="180" y="46" width="90" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="225" y="61" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Length (ft)</text>

        <!-- Width arrow (perspective front) -->
        <line x1="486" y1="123" x2="386" y2="68" stroke="#1d53c4" stroke-width="2"/>
        <path d="M482,126 L490,125 L484,117 M390,75 L384,67 L392,67" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="440" y="85" width="85" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="482" y="100" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Width (ft)</text>

        <!-- Depth arrow on front edge -->
        <line x1="500" y1="126" x2="500" y2="149" stroke="#f59e0b" stroke-width="2.5"/>
        <path d="M496,129 L500,123 L504,129 M496,146 L500,152 L504,146" stroke="#f59e0b" stroke-width="2" fill="none"/>
        <rect x="506" y="127" width="48" height="20" rx="3" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
        <text x="530" y="141" text-anchor="middle" font-size="10" font-weight="700" fill="#b45309">Depth</text>

        <!-- Formula breakdown card -->
        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">Standard Depth: <tspan fill="#0f172a">2 to 3 inches</tspan></text>
          <text x="210" y="24" font-size="11" fill="#475569" font-weight="600">Formula: <tspan fill="#1d53c4">L × W × (Depth ÷ 12) ÷ 27 = Cu Yds</tspan></text>
          <text x="440" y="24" font-size="11" fill="#b45309" font-weight="700">1 yd³ ≈ 13.5 bags (2 ft³)</text>
        </g>
      </svg>
    )}

    {slug === 'concrete-slab-calculator' && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="Concrete slab dimensions diagram">
        <defs>
          <linearGradient id="concreteGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#cbd5e1"/>
            <stop offset="100%" stop-color="#94a3b8"/>
          </linearGradient>
        </defs>

        <!-- Base gravel sub-base -->
        <polygon points="60,110 380,110 470,165 150,165" fill="#e2e8f0" stroke="#cbd5e1"/>
        <polygon points="150,165 470,165 470,185 150,185" fill="#cbd5e1"/>

        <!-- Concrete slab top -->
        <polygon points="60,80 380,80 470,135 150,135" fill="url(#concreteGrad)" stroke="#64748b"/>
        <!-- Concrete thickness face -->
        <polygon points="150,135 470,135 470,160 150,160" fill="#64748b"/>
        <polygon points="60,80 150,135 150,160 60,105" fill="#475569"/>

        <!-- Grid lines on slab surface (expansion joint marks) -->
        <line x1="220" y1="80" x2="310" y2="135" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3"/>
        <line x1="105" y1="107" x2="425" y2="107" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3"/>

        <!-- Dimension arrows -->
        <line x1="60" y1="68" x2="380" y2="68" stroke="#1d53c4" stroke-width="2"/>
        <path d="M60,64 L52,68 L60,72 M380,64 L388,68 L380,72" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="180" y="56" width="90" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="225" y="71" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Length (ft)</text>

        <line x1="478" y1="133" x2="388" y2="78" stroke="#1d53c4" stroke-width="2"/>
        <path d="M474,136 L482,135 L476,127 M392,85 L386,77 L394,77" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="435" y="95" width="85" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="477" y="110" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Width (ft)</text>

        <line x1="485" y1="136" x2="485" y2="159" stroke="#f59e0b" stroke-width="2.5"/>
        <path d="M481,139 L485,133 L489,139 M481,156 L485,162 L489,156" stroke="#f59e0b" stroke-width="2" fill="none"/>
        <rect x="492" y="137" width="62" height="20" rx="3" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
        <text x="523" y="151" text-anchor="middle" font-size="10" font-weight="700" fill="#b45309">Thick (in)</text>

        <!-- Formula breakdown card -->
        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">Patio/Sidewalk: <tspan fill="#0f172a">4 inches</tspan></text>
          <text x="175" y="24" font-size="11" fill="#475569" font-weight="600">Driveway: <tspan fill="#0f172a">5-6 inches</tspan></text>
          <text x="325" y="24" font-size="11" fill="#1d53c4" font-weight="700">1 yd³ = 45 bags (80 lb) or 60 bags (60 lb)</text>
        </g>
      </svg>
    )}

    {slug === 'gravel-calculator' && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="Gravel driveway dimensions diagram">
        <defs>
          <pattern id="gravelPat" width="12" height="12" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="2" fill="#94a3b8"/>
            <circle cx="9" cy="8" r="2.5" fill="#64748b"/>
            <circle cx="9" cy="2" r="1.5" fill="#cbd5e1"/>
            <circle cx="3" cy="9" r="1.8" fill="#475569"/>
          </pattern>
        </defs>

        <!-- Trench / Bed perspective -->
        <polygon points="60,85 380,85 470,140 150,140" fill="#e2e8f0"/>
        <polygon points="60,85 380,85 470,140 150,140" fill="url(#gravelPat)"/>
        <polygon points="150,140 470,140 470,165 150,165" fill="#475569"/>

        <!-- Dimension arrows -->
        <line x1="60" y1="70" x2="380" y2="70" stroke="#1d53c4" stroke-width="2"/>
        <path d="M60,66 L52,70 L60,74 M380,66 L388,70 L380,74" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="180" y="58" width="90" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="225" y="73" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Length (ft)</text>

        <line x1="478" y1="138" x2="388" y2="83" stroke="#1d53c4" stroke-width="2"/>
        <path d="M474,141 L482,140 L476,132 M392,90 L386,82 L394,82" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="435" y="100" width="85" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="477" y="115" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Width (ft)</text>

        <line x1="485" y1="141" x2="485" y2="164" stroke="#f59e0b" stroke-width="2.5"/>
        <path d="M481,144 L485,138 L489,144 M481,161 L485,167 L489,161" stroke="#f59e0b" stroke-width="2" fill="none"/>
        <rect x="492" y="142" width="60" height="20" rx="3" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
        <text x="522" y="156" text-anchor="middle" font-size="10" font-weight="700" fill="#b45309">Depth (in)</text>

        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">Driveway: <tspan fill="#0f172a">4 inches</tspan></text>
          <text x="160" y="24" font-size="11" fill="#475569" font-weight="600">Walkway: <tspan fill="#0f172a">2-3 inches</tspan></text>
          <text x="320" y="24" font-size="11" fill="#1d53c4" font-weight="700">Weight: 1 Cu Yd ≈ 1.4 Tons (crushed stone)</text>
        </g>
      </svg>
    )}

    {slug === 'paint-calculator' && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="Room paint wall calculation diagram">
        <!-- Room wall elevation -->
        <rect x="60" y="40" width="360" height="120" fill="#e0e7ff" stroke="#4f46e5" stroke-width="2" rx="4"/>
        <!-- Window cutout -->
        <rect x="100" y="60" width="60" height="50" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3"/>
        <text x="130" y="88" text-anchor="middle" font-size="9" fill="#64748b">Window (-)</text>
        <!-- Door cutout -->
        <rect x="300" y="70" width="50" height="90" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3"/>
        <text x="325" y="115" text-anchor="middle" font-size="9" fill="#64748b">Door (-)</text>

        <!-- Dimension arrows -->
        <line x1="60" y1="28" x2="420" y2="28" stroke="#1d53c4" stroke-width="2"/>
        <path d="M60,24 L52,28 L60,32 M420,24 L428,28 L420,32" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="200" y="16" width="100" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="250" y="31" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Wall Length (ft)</text>

        <line x1="435" y1="40" x2="435" y2="160" stroke="#1d53c4" stroke-width="2"/>
        <path d="M431,40 L435,32 L439,40 M431,160 L435,168 L439,160" stroke="#1d53c4" stroke-width="2" fill="none"/>
        <rect x="445" y="90" width="95" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="492" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Height (ft)</text>

        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">Net Area = <tspan fill="#0f172a">(Perimeter × Height) - Doors - Windows</tspan></text>
          <text x="370" y="24" font-size="11" fill="#1d53c4" font-weight="700">1 Gallon ≈ 350-400 sq ft</text>
        </g>
      </svg>
    )}

    {slug === 'drywall-calculator' && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="Drywall wall layout diagram">
        <!-- Wall frame -->
        <rect x="60" y="40" width="380" height="120" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
        <!-- Sheet grids -->
        <rect x="60" y="40" width="120" height="60" fill="#f8fafc" stroke="#0284c7" stroke-width="1.5"/>
        <text x="120" y="75" text-anchor="middle" font-size="10" font-weight="600" fill="#0284c7">4' × 8' Sheet</text>
        <rect x="180" y="40" width="120" height="60" fill="#f8fafc" stroke="#0284c7" stroke-width="1.5"/>
        <rect x="300" y="40" width="140" height="60" fill="#f8fafc" stroke="#0284c7" stroke-width="1.5"/>
        <rect x="60" y="100" width="140" height="60" fill="#f8fafc" stroke="#0284c7" stroke-width="1.5"/>
        <rect x="200" y="100" width="120" height="60" fill="#f8fafc" stroke="#0284c7" stroke-width="1.5"/>
        <rect x="320" y="100" width="120" height="60" fill="#f8fafc" stroke="#0284c7" stroke-width="1.5"/>

        <!-- Dimension arrows -->
        <line x1="60" y1="26" x2="440" y2="26" stroke="#1d53c4" stroke-width="2"/>
        <rect x="205" y="15" width="90" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="250" y="30" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Wall Width (ft)</text>

        <line x1="455" y1="40" x2="455" y2="160" stroke="#1d53c4" stroke-width="2"/>
        <rect x="465" y="90" width="85" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="507" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Height (ft)</text>

        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">Standard Sizes: <tspan fill="#0f172a">4×8 ft (32 sq ft) or 4×12 ft (48 sq ft)</tspan></text>
          <text x="375" y="24" font-size="11" fill="#b45309" font-weight="700">Add 10% for cutting waste</text>
        </g>
      </svg>
    )}

    {slug === 'roofing-calculator' && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="Roof pitch and square measurement diagram">
        <!-- Roof slope triangle -->
        <polygon points="80,140 280,60 480,140" fill="#e2e8f0" stroke="#0f172a" stroke-width="2"/>
        <!-- Shingle lines -->
        <line x1="120" y1="124" x2="440" y2="124" stroke="#94a3b8" stroke-width="1.5"/>
        <line x1="160" y1="108" x2="400" y2="108" stroke="#94a3b8" stroke-width="1.5"/>
        <line x1="200" y1="92" x2="360" y2="92" stroke="#94a3b8" stroke-width="1.5"/>
        <line x1="240" y1="76" x2="320" y2="76" stroke="#94a3b8" stroke-width="1.5"/>

        <!-- Pitch triangle visualizer -->
        <g transform="translate(340, 65)">
          <polygon points="0,40 60,40 60,0" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
          <text x="30" y="52" text-anchor="middle" font-size="10" font-weight="700" fill="#b45309">Run: 12"</text>
          <text x="75" y="22" font-size="10" font-weight="700" fill="#b45309">Rise (Pitch)</text>
        </g>

        <!-- Base span dimension -->
        <line x1="80" y1="152" x2="480" y2="152" stroke="#1d53c4" stroke-width="2"/>
        <rect x="235" y="141" width="90" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="280" y="156" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Roof Base Span</text>

        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">1 Roofing Square = <tspan fill="#0f172a">100 sq ft</tspan></text>
          <text x="230" y="24" font-size="11" fill="#475569" font-weight="600">1 Square = <tspan fill="#0f172a">3 Bundles (3-tab / architectural)</tspan></text>
          <text x="440" y="24" font-size="11" fill="#b45309" font-weight="700">+10-15% Waste</text>
        </g>
      </svg>
    )}

    {/* Fallback for other calculators: General 3D material volume guide */}
    {!['mulch-calculator', 'concrete-slab-calculator', 'gravel-calculator', 'paint-calculator', 'drywall-calculator', 'roofing-calculator'].includes(slug) && (
      <svg viewBox="0 0 560 220" class="diagram-svg" role="img" aria-label="General material dimensioning diagram">
        <defs>
          <linearGradient id="genGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#e0e7ff"/>
            <stop offset="100%" stop-color="#c7d2fe"/>
          </linearGradient>
        </defs>

        <!-- Perspective 3D box -->
        <polygon points="80,90 360,90 450,140 170,140" fill="url(#genGrad)" stroke="#4338ca"/>
        <polygon points="170,140 450,140 450,165 170,165" fill="#4338ca" opacity="0.85"/>
        <polygon points="80,90 170,140 170,165 80,115" fill="#3730a3"/>

        <!-- Dimension arrows -->
        <line x1="80" y1="76" x2="360" y2="76" stroke="#1d53c4" stroke-width="2"/>
        <rect x="175" y="65" width="90" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="220" y="80" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Length (ft)</text>

        <line x1="458" y1="138" x2="368" y2="88" stroke="#1d53c4" stroke-width="2"/>
        <rect x="420" y="100" width="85" height="22" rx="4" fill="#ffffff" stroke="#1d53c4" stroke-width="1.5"/>
        <text x="462" y="115" text-anchor="middle" font-size="11" font-weight="700" fill="#1d53c4">Width (ft)</text>

        <line x1="465" y1="141" x2="465" y2="164" stroke="#f59e0b" stroke-width="2.5"/>
        <rect x="475" y="142" width="70" height="20" rx="3" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
        <text x="510" y="156" text-anchor="middle" font-size="10" font-weight="700" fill="#b45309">Depth / Thick</text>

        <g transform="translate(16, 170)">
          <rect width="528" height="38" rx="6" fill="#f8fafc" stroke="#e2e8f0"/>
          <text x="14" y="24" font-size="11" fill="#475569" font-weight="600">Core Formula: <tspan fill="#1d53c4">Area = Length × Width</tspan></text>
          <text x="210" y="24" font-size="11" fill="#475569" font-weight="600">Volume = <tspan fill="#1d53c4">Area × (Depth in inches ÷ 12)</tspan></text>
          <text x="415" y="24" font-size="11" fill="#b45309" font-weight="700">1 Cu Yd = 27 Cu Ft</text>
        </g>
      </svg>
    )}
  </div>
</div>

<style>
  .calc-diagram-card {
    background: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .diagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid #f1f5f9;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--action);
    background: #eff6ff;
    padding: 3px 10px;
    border-radius: var(--radius);
  }

  .diagram-hint {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .diagram-viewport {
    width: 100%;
    overflow: hidden;
  }

  .diagram-svg {
    width: 100%;
    height: auto;
    display: block;
    max-height: 240px;
  }
</style>
