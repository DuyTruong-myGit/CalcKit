---
/**
 * [slug].astro — dynamic route for calculator pages
 * Builds a page for every JSON definition in src/data/calculators/
 *
 * Rules:
 * - Draft pages (status: "draft") get noindex, nofollow.
 * - Single H1 per page.
 * - Section order follows docs/CONTENT_GUIDE.md and Brief §5.
 * - Common mistakes rendered as callout-warning blocks (Brief §7).
 */
import { readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import type { CalculatorDef } from '../lib/schema/types';

export async function getStaticPaths() {
  const dataDir = join(process.cwd(), 'src', 'data', 'calculators');
  const files = readdirSync(dataDir).filter((f) => f.endsWith('.json'));

  return files.map((file) => {
    const raw = readFileSync(join(dataDir, file), 'utf-8');
    const def = JSON.parse(raw) as CalculatorDef;
    return {
      params: { slug: def.slug },
      props: { def },
    };
  });
}

interface Props {
  def: CalculatorDef;
}

const { def } = Astro.props;
const isDraft = def.status === 'draft';

// Category labels for breadcrumb
const CATEGORY_LABELS: Record<string, string> = {
  'landscaping': 'Landscaping & Garden',
  'concrete-masonry': 'Concrete & Masonry',
  'painting-flooring': 'Painting & Flooring',
  'structures-roofing': 'Outdoor Structures & Roofing',
  'utilities': 'Measurement Utilities',
};
const categoryLabel = CATEGORY_LABELS[def.category] ?? def.category;

// Schema.org structured data (WebApplication + FAQPage matching visible content)
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: def.title,
    description: def.metaDescription,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  ...(def.content.faq && def.content.faq.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: def.content.faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: {
              '@type': 'Answer',
              text: item.a,
            },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
      { '@type': 'ListItem', position: 2, name: categoryLabel, item: '/categories/' },
      { '@type': 'ListItem', position: 3, name: def.title },
    ],
  },
];
---

<Base
  metaTitle={def.metaTitle}
  metaDescription={def.metaDescription}
  noindex={isDraft}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="calculator-page">
    <!-- Breadcrumb navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/categories/">{categoryLabel}</a></li>
        <li aria-current="page">{def.title}</li>
      </ol>
    </nav>

    <header class="page-header">
      <h1>{def.title}</h1>
      <p class="intro-text">{def.content.intro}</p>
    </header>

    <Calculator def={def} />

    <AdSlot position="below-calculator" />

    <hr class="section-divider" />

    <section class="content-section" aria-labelledby="how-it-works-heading">
      <h2 id="how-it-works-heading">How it works</h2>
      <p>{def.content.howItWorks}</p>
    </section>

    {def.content.examples && def.content.examples.length > 0 && (
      <section class="content-section" aria-labelledby="examples-heading">
        <h2 id="examples-heading">Worked examples</h2>
        <div class="examples-list">
          {def.content.examples.map((ex) => (
            <div class="example-card">
              <h3>{ex.title}</h3>
              <p>{ex.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {def.content.quickReference && (
      <section class="content-section" aria-labelledby="quick-ref-heading">
        <h2 id="quick-ref-heading">Quick reference table</h2>
        <div class="table-container">
          <table class="quick-ref-table">
            <caption>{def.content.quickReference.caption}</caption>
            <thead>
              <tr>
                {def.content.quickReference.headers.map((h) => (
                  <th scope="col">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {def.content.quickReference.rows.map((row) => (
                <tr>
                  {row.map((cell, idx) => (
                    idx === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {def.content.commonMistakes && def.content.commonMistakes.length > 0 && (
      <section class="content-section" aria-labelledby="mistakes-heading">
        <h2 id="mistakes-heading">Common mistakes to avoid</h2>
        <div class="mistakes-list">
          {def.content.commonMistakes.map((m) => (
            <div class="callout callout-warning">
              <span class="callout-icon" aria-hidden="true">⚠️</span>
              <span>{m}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {def.content.faq && def.content.faq.length > 0 && (
      <FAQ items={def.content.faq} />
    )}

    <AdSlot position="below-faq" />

    {def.related && def.related.length > 0 && (
      <RelatedLinks slugs={def.related} />
    )}
  </article>
</Base>

<style>
  .calculator-page {
    display: flex;
    flex-direction: column;
  }

  /* ── Breadcrumb ──────────────────────────────────────────────────────────── */
  .breadcrumb {
    margin-bottom: var(--space-5);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-1);
    color: var(--rule);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--action);
    text-decoration: underline;
  }

  .breadcrumb [aria-current="page"] {
    color: var(--ink);
    font-weight: 500;
  }

  /* ── Page header ─────────────────────────────────────────────────────────── */
  .page-header {
    margin-bottom: var(--space-6);
  }

  .intro-text {
    font-size: 1.0625rem;
    color: var(--ink);
    line-height: 1.65;
    max-width: 65ch;
  }

  /* ── Content sections ────────────────────────────────────────────────────── */
  .content-section {
    margin: var(--space-8) 0;
  }

  .content-section h2 {
    margin-bottom: var(--space-4);
  }

  .content-section p {
    line-height: 1.65;
  }

  /* ── Worked examples ─────────────────────────────────────────────────────── */
  .examples-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .example-card {
    border-left: 3px solid var(--action);
    padding: var(--space-4) var(--space-5);
    background: #f8fafc;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .example-card h3 {
    margin-bottom: var(--space-2);
    font-size: 1rem;
    font-weight: 600;
  }

  .example-card p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* ── Quick reference table ──────────────────────────────────────────────── */
  .table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .quick-ref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    text-align: left;
  }

  .quick-ref-table caption {
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--muted);
    text-align: left;
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }

  .quick-ref-table th,
  .quick-ref-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }

  .quick-ref-table thead th {
    background: #f1f5f9;
    font-weight: 600;
    color: var(--ink);
  }

  .quick-ref-table tbody th {
    font-weight: 500;
    color: var(--ink);
  }

  .quick-ref-table tbody tr:last-child th,
  .quick-ref-table tbody tr:last-child td {
    border-bottom: none;
  }

  .quick-ref-table tbody tr:hover {
    background: var(--surface);
  }

  /* ── Common mistakes (callout-warning via global.css) ───────────────────── */
  .mistakes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
