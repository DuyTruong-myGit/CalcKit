---

<Base
  metaTitle="Free Material Calculators for Home & Garden DIY Projects"
  metaDescription="Free, accurate material calculators for US homeowners: mulch, gravel, concrete, paint, flooring, roofing, and more. Calculate bags, yards, and tons with clear math."
  containerWidth="wide"
>
  <div class="home-page">
    <!-- ── Hero Banner ──────────────────────────────────────────────────────── -->
    <header class="hero-banner">
      <div class="hero-pill">
        <span class="hero-dot"></span>
        <span>100% Free · No Sign-Up · Verified Math</span>
      </div>
      <h1>Material Calculators for Home&nbsp;&amp;&nbsp;Garden</h1>
      <p class="hero-lead">
        Enter your dimensions and get instant, accurate estimates for mulch, gravel, concrete,
        paint, flooring, roofing, and more. Runs entirely in your browser with zero bloat.
      </p>

      <!-- Instant Search Box -->
      <div class="search-container">
        <div class="search-input-wrap">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="calc-search"
            type="search"
            placeholder="Search e.g. mulch, concrete slab, drywall, paint, gravel..."
            aria-label="Filter calculators"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="category-tabs" role="tablist" aria-label="Calculator Categories">
        <button class="cat-tab active" data-filter="all" role="tab" aria-selected="true">All (20)</button>
        <button class="cat-tab" data-filter="landscaping" role="tab" aria-selected="false">🌿 Landscaping</button>
        <button class="cat-tab" data-filter="concrete-masonry" role="tab" aria-selected="false">🧱 Concrete & Masonry</button>
        <button class="cat-tab" data-filter="painting-flooring" role="tab" aria-selected="false">🎨 Paint & Floor</button>
        <button class="cat-tab" data-filter="structures-roofing" role="tab" aria-selected="false">🏡 Structures & Roof</button>
        <button class="cat-tab" data-filter="utilities" role="tab" aria-selected="false">📐 Utilities</button>
      </div>
    </header>

    <!-- ── Calculators Grid ─────────────────────────────────────────────────── -->
    <section class="tools-section" aria-labelledby="tools-heading">
      <div class="section-title-row">
        <h2 id="tools-heading">Available Estimators</h2>
        <span id="results-count" class="results-count">Showing all 20 tools</span>
      </div>

      <div id="calc-grid" class="tools-grid">
        {ALL_CALCULATORS.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="tool-card"
            data-category={calc.category}
            data-search={`${calc.title} ${calc.desc} ${calc.formula} ${calc.categoryName}`.toLowerCase()}
          >
            <div class="card-head">
              <div class="card-icon" set:html={calc.icon} />
              <div class="card-meta">
                <span class={`card-badge badge-${calc.category}`}>{calc.categoryName}</span>
              </div>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </div>

            <h3 class="card-title">{calc.title}</h3>
            <p class="card-desc">{calc.desc}</p>

            <div class="card-footer">
              <span class="formula-chip">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                {calc.formula}
              </span>
            </div>
          </a>
        ))}
      </div>

      <div id="no-results" class="no-results" hidden>
        <p>No calculator found matching your search. Try typing "mulch", "concrete", or "paint".</p>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── How It Works Strip ───────────────────────────────────────────────── -->
    <section class="workflow-section" aria-labelledby="workflow-heading">
      <h2 id="workflow-heading">How CalcKit Works</h2>
      <p class="section-sub">From tape measure to checkout in three simple steps.</p>

      <div class="workflow-grid">
        <div class="workflow-card">
          <div class="step-badge">1</div>
          <div class="wf-content">
            <h3>Measure Your Area</h3>
            <p>Walk your space with a tape measure. You only need 2–3 numbers: length, width, and thickness.</p>
          </div>
        </div>

        <div class="workflow-card">
          <div class="step-badge">2</div>
          <div class="wf-content">
            <h3>Enter Your Numbers</h3>
            <p>Default values are pre-filled with realistic standards. Results recalculate live as you type.</p>
          </div>
        </div>

        <div class="workflow-card">
          <div class="step-badge">3</div>
          <div class="wf-content">
            <h3>Buy With Confidence</h3>
            <p>Get exact store units: bags (60lb / 80lb / 2 cu ft), cubic yards, tons, or pallets with built-in waste buffer.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── Trust Section ────────────────────────────────────────────────────── -->
    <section class="trust-section" aria-labelledby="trust-heading">
      <h2 id="trust-heading">Why DIYers Trust CalcKit</h2>
      <div class="trust-grid">
        <div class="trust-card">
          <div class="trust-icon-box">✓</div>
          <h3>Verified Math & Formulas</h3>
          <p>Every calculation is tested against engineering standards and manufacturer specifications. Full transparency into formulas.</p>
        </div>

        <div class="trust-card">
          <div class="trust-icon-box">⚡</div>
          <h3>Yard & Mobile Ready</h3>
          <p>Built for phones outdoors in direct sunlight. Large tap targets, live reactive numbers, and no sluggish JavaScript frameworks.</p>
        </div>

        <div class="trust-card">
          <div class="trust-icon-box">🔒</div>
          <h3>100% Private</h3>
          <p>Everything computes client-side in your browser. Your measurements are never sent to a server or tracked.</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<!-- Client script for live search and category filtering -->
<script>
  const searchInput = document.getElementById('calc-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.tool-card');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
  const noResults = document.getElementById('no-results');
  const resultsCount = document.getElementById('results-count');

  let activeCategory = 'all';
  let searchTerm = '';

  function filterCards() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCat = card.dataset.category ?? '';
      const cardSearch = card.dataset.search ?? '';

      const matchCat = activeCategory === 'all' || cardCat === activeCategory;
      const matchSearch = searchTerm === '' || cardSearch.includes(searchTerm);

      if (matchCat && matchSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} tools`;
    }
  }

  // Search input handler
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterCards();
    });
  }

  // Category tab handler
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      activeCategory = tab.dataset.filter ?? 'all';
      filterCards();
    });
  });
</script>

<style>
  .home-page {
    width: 100%;
  }

  /* ── Hero Banner ────────────────────────────────────────────────────────── */
  .hero-banner {
    padding: var(--space-8) 0 var(--space-8);
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-8);
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px;
    background: #eff6ff;
    color: var(--action);
    border: 1px solid #bfdbfe;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--action);
  }

  .hero-banner h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.18;
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .hero-banner h1 { font-size: 2.875rem; }
  }

  .hero-lead {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 auto var(--space-6);
    max-width: 60ch;
  }

  /* ── Search Container ───────────────────────────────────────────────────── */
  .search-container {
    max-width: 580px;
    margin: 0 auto var(--space-5);
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    color: var(--muted);
    pointer-events: none;
  }

  .search-input-wrap input {
    width: 100%;
    height: 52px;
    padding: 0 16px 0 48px;
    font-size: 1rem;
    font-family: inherit;
    color: var(--ink);
    background: #ffffff;
    border: 2px solid var(--rule);
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .search-input-wrap input:focus {
    outline: none;
    border-color: var(--action);
    box-shadow: 0 0 0 3px rgba(29, 83, 196, 0.15);
  }

  /* ── Category Tabs ──────────────────────────────────────────────────────── */
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: var(--space-4);
  }

  .cat-tab {
    padding: 6px 14px;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .cat-tab:hover {
    color: var(--ink);
    border-color: #cbd5e1;
    background: #e2e8f0;
  }

  .cat-tab.active {
    color: #ffffff;
    background: var(--action);
    border-color: var(--action);
    box-shadow: 0 2px 6px rgba(29, 83, 196, 0.25);
  }

  /* ── Tools Section ──────────────────────────────────────────────────────── */
  .tools-section {
    margin-bottom: var(--space-10);
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .results-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
