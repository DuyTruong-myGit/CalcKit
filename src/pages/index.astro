---
/**
 * index.astro — Home page
 * Clean, practical directory of home and garden material calculators.
 */
import Base from '../layouts/Base.astro';

const FEATURED_CALCULATORS = [
  {
    slug: 'mulch-calculator',
    title: 'Mulch Calculator',
    badge: 'Popular',
    desc: 'Calculate bags and cubic yards of mulch for planting beds and borders. Includes depth recommendations and waste factor.',
  },
  {
    slug: 'gravel-calculator',
    title: 'Gravel Calculator',
    badge: 'Popular',
    desc: 'Estimate tons and cubic yards of crushed stone or pea gravel for driveways, walkways, and French drains.',
  },
  {
    slug: 'topsoil-calculator',
    title: 'Topsoil Calculator',
    badge: 'Garden',
    desc: 'Determine cubic yards and dump truck tonnage for lawn leveling, grading, and new garden beds.',
  },
  {
    slug: 'sand-calculator',
    title: 'Sand Calculator',
    badge: 'Landscaping',
    desc: 'Calculate tons and volume of sand for paver setting beds, above-ground pools, and sandboxes.',
  },
  {
    slug: 'raised-bed-soil-calculator',
    title: 'Raised Bed Soil Calculator',
    badge: 'Garden',
    desc: 'Determine retail soil bags and cubic yards needed to fill raised garden boxes and planters.',
  },
  {
    slug: 'concrete-slab-calculator',
    title: 'Concrete Slab Calculator',
    badge: 'Masonry',
    desc: 'Determine cubic yards and premixed 80-lb or 60-lb bag counts for patios, sidewalks, and shed foundations.',
  },
  {
    slug: 'paver-calculator',
    title: 'Paver Calculator',
    badge: 'Masonry',
    desc: 'Calculate brick or stone pavers needed for patios and walkways with cut-waste allowances.',
  },
  {
    slug: 'retaining-wall-block-calculator',
    title: 'Retaining Wall Block Calculator',
    badge: 'Masonry',
    desc: 'Determine structural wall blocks and finishing capstones for retaining walls and raised terraces.',
  },
];
---

<Base
  metaTitle="Free Material Calculators for Home & Garden DIY Projects"
  metaDescription="Free, accurate material calculators for US homeowners: mulch, gravel, concrete slabs, and more. Calculate bags, yards, and tons with clear math."
>
  <div class="home-page">
    <header class="hero-section">
      <p class="hero-eyebrow">Free online tools — no account needed</p>
      <h1>Material calculators for home&nbsp;&amp;&nbsp;garden</h1>
      <p class="hero-lead">
        Get instant, accurate estimates for materials before you head to the store or call
        for delivery. Every calculator runs in your browser with full transparency
        into&nbsp;the&nbsp;math.
      </p>
    </header>

    <section class="featured-section" aria-labelledby="featured-heading">
      <div class="section-header">
        <h2 id="featured-heading">Popular calculators</h2>
        <a href="/categories/" class="view-all-link">All 20 calculators &rarr;</a>
      </div>

      <div class="featured-grid">
        {FEATURED_CALCULATORS.map((calc) => (
          <a href={`/${calc.slug}/`} class="calc-card">
            <div class="card-top">
              <span class="card-badge">{calc.badge}</span>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>{calc.title}</h3>
            <p>{calc.desc}</p>
          </a>
        ))}
      </div>

      <div class="cta-row">
        <a href="/categories/" class="cta-link">Browse all categories &rarr;</a>
      </div>
    </section>

    <hr class="section-divider" />

    <section class="trust-section">
      <h2>Why use our calculators?</h2>
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">✓</div>
          <h3>Exact math, verified</h3>
          <p>
            Every formula is tested against hand-calculated standards. We show the exact
            conversions and formulas so you can trust the numbers.
          </p>
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">⚡</div>
          <h3>Fast &amp; phone-ready</h3>
          <p>
            Designed for mobile use in your yard with a tape measure. Live results,
            large tap targets, and no heavy frameworks slowing you&nbsp;down.
          </p>
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">🔒</div>
          <h3>Private by design</h3>
          <p>
            Everything runs in your browser. Your measurements are never sent to a server,
            stored in a database, or sold to advertisers.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-page {
    max-width: 720px;
  }

  /* ── Hero ────────────────────────────────────────────────────────────────── */
  .hero-section {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--rule);
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--action);
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-2);
  }

  .hero-section h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  @media (min-width: 480px) {
    .hero-section h1 { font-size: 2rem; }
  }

  .hero-lead {
    font-size: 1.0625rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
    max-width: 60ch;
  }

  /* ── Section header ─────────────────────────────────────────────────────── */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all-link {
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* ── Calculator cards grid ──────────────────────────────────────────────── */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 560px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .calc-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-5);
    background: var(--page);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
    display: flex;
    flex-direction: column;
  }

  .calc-card:hover {
    border-color: var(--action);
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    text-decoration: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .card-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    background: #e8eefb;
    color: var(--action);
    border-radius: var(--radius);
  }

  .card-arrow {
    color: var(--muted);
    font-size: 1.125rem;
    transition: transform 0.15s;
  }

  .calc-card:hover .card-arrow {
    color: var(--action);
    transform: translateX(2px);
  }

  .calc-card h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .calc-card p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }

  /* ── CTA row ────────────────────────────────────────────────────────────── */
  .cta-row {
    margin-top: var(--space-6);
    text-align: center;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border: 1.5px solid var(--action);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--action);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .cta-link:hover {
    background: var(--action);
    color: var(--page);
    text-decoration: none;
  }

  /* ── Trust section ──────────────────────────────────────────────────────── */
  .trust-section {
    margin-top: var(--space-8);
  }

  .trust-section h2 {
    margin-bottom: var(--space-6);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 560px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }

  .trust-icon {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f4ff;
    border-radius: var(--radius);
  }

  .trust-item h3 {
    font-size: 0.9375rem;
    margin-bottom: var(--space-1);
  }

  .trust-item p {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }
</style>
