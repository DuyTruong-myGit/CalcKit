---
/**
 * privacy-policy.astro — Privacy Policy
 * Follows structure in docs/CONTENT_GUIDE.md section 7
 */
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../config';
---

<Base
  metaTitle={`Privacy Policy | ${SITE_CONFIG.siteName}`}
  metaDescription={`Privacy policy for ${SITE_CONFIG.siteName}: our calculators run client-side in your browser, and no personal numbers or project details are collected.`}
>
  <article class="prose-page">
    <h1>Privacy Policy</h1>
    <p class="effective-date">Last updated: November 24, 2026</p>

    <p>
      {SITE_CONFIG.siteName} ("we", "us", or "our") respects your privacy. This policy outlines
      how our website operates and explains our strict commitment to not collecting unnecessary
      user information.
    </p>

    <h2>1. Information we do not collect</h2>
    <p>
      All calculations run entirely in your web browser using client-side JavaScript. The dimensions,
      depths, areas, and quantities you input into our calculators are never transmitted to our
      servers, stored in any database, or shared with third parties.
    </p>

    <h2>2. Analytics</h2>
    <p>
      {SITE_CONFIG.analytics === 'none' ? (
        'We currently do not use any analytics trackers or tracking cookies on this site.'
      ) : (
        `We use privacy-friendly analytics (${SITE_CONFIG.analytics}) to understand aggregated visitor trends without collecting personally identifiable information.`
      )}
    </p>

    <h2>3. Advertising</h2>
    <p>
      {SITE_CONFIG.adsEnabled ? (
        'We display advertisements provided by Google AdSense to support the maintenance of this free resource. Third-party vendors, including Google, use cookies to serve ads based on your prior visits to this and other websites. You may opt out of personalized advertising by visiting Google Ad Settings.'
      ) : (
        'We currently do not display advertisements or load third-party advertising scripts. In the future, we may enable display advertising through Google AdSense to fund site hosting. When enabled, third-party advertising partners may use cookies to deliver non-personalized or personalized ads subject to applicable privacy laws.'
      )}
    </p>

    <h2>4. Cookies</h2>
    <p>
      Cookies are small text files placed on your device by websites you visit. Because our calculators
      operate statically in your browser without user accounts, we do not set any first-party cookies.
      You can manage or disable cookies at any time through your web browser preferences.
    </p>

    <h2>5. Third-party links</h2>
    <p>
      Our website may link to external websites, manufacturer product sheets, or reference materials.
      We have no control over the privacy practices or content of third-party websites and encourage
      you to read their respective privacy policies.
    </p>

    <h2>6. Children's privacy</h2>
    <p>
      Our website provides general home improvement calculators and is not directed to children
      under 13 years of age. We do not knowingly collect personal information from children.
    </p>

    <h2>7. Your rights and contact information</h2>
    <p>
      If you have questions about this privacy policy, please contact us by email at
      <a href={`mailto:${SITE_CONFIG.contactEmail}`}>{SITE_CONFIG.contactEmail}</a>.
    </p>
  </article>
</Base>

<style>
  .prose-page {
    max-width: 68ch;
  }
  .prose-page h1 {
    margin-bottom: var(--space-2);
  }
  .effective-date {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: var(--space-6);
  }
  .prose-page h2 {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .prose-page p {
    margin-bottom: var(--space-4);
    line-height: 1.65;
  }
</style>
